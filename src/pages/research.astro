---
import Layout from '../layouts/Layout.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import StudyCard from '../components/StudyCard.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { researchStudies } from '../data/researchStudies';
import { evidenceMatrix } from '../data/evidenceMatrix';

const tocItems = [
  { id: "evidence-summary", label: "Research Evidence Registry" },
  { id: "overlapping-caveat", label: "Methodological Overlap Warning" },
  { id: "evidence-matrix", label: "Evidence Strength Table" },
  { id: "all-studies", label: "Peer-Reviewed Study Dossiers" },
  { id: "thorne-evaluation", label: "Brand Evaluation Framework" },
  { id: "reddit-critique", label: "Online Consumer Reviews vs Reality" },
];
---

<Layout
  title="Berberine Research Papers & Clinical Evidence Library"
  description="Peer-reviewed clinical evidence on berberine. Meta-analyses and RCTs by Lei (2026), Vahed (2026), and Nie (2024) with full citations and PubMed links."
>
  <!-- Header Banner -->
  <div class="bg-white border-b border-[#e6e6e6] py-6">
    <div class="site-container">
      <nav class="text-xs text-[#615d59] mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5 list-none p-0 m-0">
          <li><a href="/" class="hover:text-[#0075de]">Home</a></li>
          <li>/</li>
          <li class="text-[#000000] font-medium" aria-current="page">Scientific Research Library</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="badge-pill bg-[#213183] text-white text-xs font-semibold">
          Scientific Evidence Library
        </span>
        <span class="text-xs text-[#615d59]">Peer-Reviewed Papers & Critical Review • Systematic Literature Directory</span>
      </div>
      <h1 class="display-2 text-[#000000] tracking-tight m-0">
        Scientific Research Papers and Evidence Summary
      </h1>
      <p class="body-md text-[#615d59] mt-3 max-w-3xl">
        The complete peer-reviewed clinical foundation evaluated across this portal. Featuring full author listings, journal citations, direct DOIs, sample sizes, and critical analyses of anecdotal claims.
      </p>
    </div>
  </div>

  <!-- Content Layout -->
  <div class="site-container py-10">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <!-- Main Content (3 Columns) -->
      <div class="lg:col-span-3 space-y-10 sm:space-y-12">
        <!-- Mobile / iPad Quick Navigation (Hidden on Desktop) -->
        <div class="lg:hidden">
          <TableOfContents items={tocItems} title="Research Library" mobileInline={true} />
        </div>

        <!-- Part 3: Evidence Summary Table -->
        <section id="evidence-summary" class="space-y-4">
          <div class="flex items-center justify-between border-b border-[#e6e6e6] pb-2">
            <h2 class="heading-1 text-[#000000] tracking-tight m-0">
              Research Evidence Summary Table
            </h2>
            <span class="text-xs text-[#615d59]">{researchStudies.length} Key Studies & Reviews Evaluated</span>
          </div>
          <p class="body-md text-[#31302e]">
            These peer-reviewed systematic reviews, randomized controlled trials, and laboratory analyses constitute the core scientific foundation evaluated across our research portal:
          </p>

          <div class="table-container shadow-sm">
            <table class="data-table" aria-label="Research Evidence Summary Table">
              <thead>
                <tr>
                  <th class="w-12">No.</th>
                  <th class="w-1/3">Research Paper & Journal</th>
                  <th>Key Authors</th>
                  <th>Year</th>
                  <th>Participants / Cohort</th>
                  <th>Key Findings & Clinical Reductions</th>
                </tr>
              </thead>
              <tbody>
                {researchStudies.map((study, idx) => (
                  <tr>
                    <td class="font-mono text-xs text-[#615d59]">{idx + 1}</td>
                    <td>
                      <a href={`#study-${study.id}`} class="font-bold text-[#000000] hover:text-[#0075de] block text-xs">
                        {study.title}
                      </a>
                      <span class="text-[11px] text-[#615d59] italic block mt-0.5">
                        {study.journal}
                      </span>
                    </td>
                    <td class="text-xs font-medium text-[#31302e]">
                      {study.authors.slice(0, 3).join(', ')}{study.authors.length > 3 ? ' et al.' : ''}
                    </td>
                    <td class="text-xs font-mono">{study.year}</td>
                    <td class="text-xs font-bold text-[#0075de]">{typeof study.participants === 'number' ? study.participants.toLocaleString() : study.participants}</td>
                    <td class="text-xs text-[#31302e] leading-snug">
                      {study.quoteOrSummary}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Methodological Caveat: Overlapping Cohorts -->
        <section id="overlapping-caveat">
          <div class="p-4 rounded-xl bg-[#fffaf5] border border-[#e6cbb2] text-xs text-[#523410] leading-relaxed">
            <strong class="font-semibold text-[#793400] text-sm block mb-1">
              Important Methodological Caveat on Aggregated Participant Numbers:
            </strong>
            These published systematic reviews examine overlapping clinical research areas (particularly dyslipidemia and metabolic syndrome) and include several of the same primary clinical trials. <strong>Their participant counts must not be summed additively</strong> and described as independent cohorts. Scientific rigor demands recognizing between-review trial overlap.
          </div>
        </section>

        <!-- Complete Evidence Strength Matrix -->
        <section id="evidence-matrix" class="space-y-4 pt-6 border-t border-[#e6e6e6]">
          <div class="flex items-center justify-between border-b border-[#e6e6e6] pb-2">
            <div>
              <h2 class="heading-1 text-[#000000] tracking-tight m-0">
                How Strong Is the Evidence? Complete Matrix
              </h2>
              <span class="text-xs text-[#615d59]">11 Health Outcomes Evaluated</span>
            </div>
            <a href="/editorial-methodology/" class="text-xs text-[#0075de] font-semibold hover:underline">
              Editorial Methodology →
            </a>
          </div>
          <p class="body-md text-[#31302e]">
            This clinical grading distinguishes between outcomes substantiated by multiple double-blind RCTs versus preliminary laboratory observations or unsupported commercial marketing:
          </p>

          <div class="table-container shadow-sm">
            <table class="data-table" aria-label="Evidence Strength Evaluation Table">
              <thead>
                <tr>
                  <th class="w-1/3">Health Outcome / Claim</th>
                  <th class="w-1/3">Current Evidence Status</th>
                  <th>Clinical Interpretation & Nuance</th>
                </tr>
              </thead>
              <tbody>
                {evidenceMatrix.map((item) => (
                  <tr>
                    <td class="font-bold text-[#000000] text-xs">
                      {item.healthOutcome}
                    </td>
                    <td>
                      <EvidenceBadge level={item.evidenceLevel} text={item.interpretation} size="sm" />
                    </td>
                    <td class="text-xs text-[#615d59] leading-relaxed">
                      {item.detail}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Detailed Study Deep Dive Cards -->
        <section id="all-studies" class="space-y-6 pt-6 border-t border-[#e6e6e6]">
          <span class="eyebrow text-[#0075de]">Primary Literature Dossiers</span>
          <h2 class="heading-1 text-[#000000] tracking-tight">
            Detailed Dossiers: Evaluated Research Papers
          </h2>
          <p class="body-md text-[#31302e]">
            Each study and review evaluated below includes its study design classification, complete citation, participant cohort, protocol dose and duration, primary outcomes, limitations, conflicts of interest, and direct link to PubMed or publisher:
          </p>

          <div class="space-y-6">
            {researchStudies.map((study) => (
              <StudyCard study={study} />
            ))}
          </div>
        </section>

        <!-- Chapter 12: Thorne Berberine Evaluation Framework -->
        <section id="thorne-evaluation" class="space-y-5 pt-6 border-t border-[#e6e6e6]">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-[#dd5b00] uppercase tracking-wider">
            <span>Chapter 12: Product & Consumer Realities</span>
          </div>
          <h2 class="heading-1 text-[#000000] tracking-tight">
            What Is Thorne Berberine? Brand Evaluation Framework
          </h2>
          <div class="body-md text-[#31302e] space-y-4 leading-relaxed">
            <p>
              <strong>Thorne</strong> is a prominent commercial dietary supplement manufacturer that markets berberine formulations (including its current dual-action formulation combining 450 mg Berberine HCl and 550 mg Berberine Phytosome per serving).
            </p>
            <p>
              For an evidence-based research portal, any clinical appraisal must carefully <strong>distinguish between brand reputation and the peer-reviewed clinical evidence supporting the specific formulation itself</strong>:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-sm">
              <li><strong>Labeled Ingredient Quantities:</strong> Does the product provide an unambiguous declaration of Berberine HCl and phytosome milligrams per serving?</li>
              <li><strong>Facility vs Product Testing:</strong> Is the facility registered by NSF International for cGMP compliance, or does the finished product carry an independent third-party consumer seal (e.g., USP or NSF Certified for Sport)? Facility registration verifies manufacturing systems, not finished bottle certification.</li>
              <li><strong>Formulation vs Hype:</strong> Does the company rely on standard research-grade berberine HCl, or does it market modified absorption complexes without published human outcome trials?</li>
            </ul>
            <div class="p-3 bg-[#f6f5f4] border border-[#e6e6e6] rounded-lg text-xs text-[#615d59]">
              <strong>Methodological Policy:</strong> Because manufacturer sourcing, packaging, and excipient binders can change over time, current Supplement Facts panels and Certificates of Analysis (CoAs) should be verified directly from the manufacturer rather than relying on historical reviews.
            </div>
          </div>
        </section>

        <!-- Chapter 12: Reddit User Reviews Critique -->
        <section id="reddit-critique" class="space-y-5 pt-6 border-t border-[#e6e6e6]">
          <h2 class="heading-1 text-[#000000] tracking-tight">
            What Do Reddit Users Say About Berberine?
          </h2>
          <div class="body-md text-[#31302e] space-y-4 leading-relaxed">
            <p>
              Subreddits such as <code>r/Supplements</code>, <code>r/Berberine</code>, and <code>r/PCOS</code> host thousands of anecdotal discussions and self-reported patient experiences. Common themes in these discussions include:
            </p>
            <ul class="list-disc pl-5 space-y-1 text-sm">
              <li><strong>Weight Loss Stories:</strong> Variable claims ranging from rapid early weight loss to zero noticeable changes.</li>
              <li><strong>Blood Sugar Readings:</strong> Users tracking continuous glucose monitors (CGMs) reporting flattened postprandial glucose spikes.</li>
              <li><strong>Gastrointestinal Distress:</strong> Widespread complaints of abdominal cramping, constipation, severe diarrhea, or flatulence upon starting.</li>
              <li><strong>Comparisons to Prescription Drugs:</strong> Consumers discussing berberine as a surrogate for metformin or semaglutide.</li>
            </ul>

            <h3 class="heading-2 text-[#000000] pt-2">Why Anecdotal Online Reviews Cannot Replace Clinical Trials</h3>
            <p>
              While Reddit discussions provide valuable insight into consumer questions and real-world compliance barriers, <strong>online self-reports have severe scientific limitations</strong>:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              <div class="feature-card">
                <span class="text-xs font-bold text-[#793400] uppercase tracking-wider block mb-1">Confounding Variables</span>
                <p class="text-xs text-[#31302e] m-0 leading-relaxed">
                  Users on Reddit rarely isolate berberine: they frequently change their diet, begin exercise routines, or alter concurrent supplements and medications simultaneously.
                </p>
              </div>
              <div class="feature-card">
                <span class="text-xs font-bold text-[#793400] uppercase tracking-wider block mb-1">Absence of Placebo Controls</span>
                <p class="text-xs text-[#31302e] m-0 leading-relaxed">
                  The psychological placebo effect and expectation bias heavily influence self-reported energy levels, appetite suppression, and bowel sensations.
                </p>
              </div>
              <div class="feature-card">
                <span class="text-xs font-bold text-[#793400] uppercase tracking-wider block mb-1">Extreme Selection Bias</span>
                <p class="text-xs text-[#31302e] m-0 leading-relaxed">
                  Individuals who experience dramatic benefits or severe gastrointestinal misery are vastly more motivated to post online than individuals with average, modest responses.
                </p>
              </div>
              <div class="feature-card">
                <span class="text-xs font-bold text-[#793400] uppercase tracking-wider block mb-1">Unverified Diagnoses</span>
                <p class="text-xs text-[#31302e] m-0 leading-relaxed">
                  Reports lack standardized laboratory blood draws, verified baselines, and certified medical oversight.
                </p>
              </div>
            </div>

            <p class="body-sm text-[#615d59] italic">
              <strong>Conclusion:</strong> Reddit posts can help clinicians identify real-world consumer concerns and tolerability roadblocks, but <em>they must never be conflated with clinical evidence of medical efficacy</em>.
            </p>
          </div>
        </section>

        <!-- Medical Disclaimer -->
        <MedicalDisclaimer variant="callout" />
      </div>

      <!-- Table of Contents Sidebar (1 Column) -->
      <aside class="hidden lg:block lg:col-span-1">
        <TableOfContents items={tocItems} title="Research Library" />
      </aside>
    </div>
  </div>
</Layout>
