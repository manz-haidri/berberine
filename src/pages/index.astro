---
import Layout from '../layouts/Layout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import ProductComparison from '../components/ProductComparison.astro';
import FaqSection from '../components/FaqSection.astro';
import { researchStudies } from '../data/researchStudies';

const lei2026 = researchStudies.find((s) => s.id === 'lei-2026')!;
const vahed2026 = researchStudies.find((s) => s.id === 'vahed-2026')!;
const lei2023 = researchStudies.find((s) => s.id === 'lei-2023')!;

const compactEvidenceList = [
  { outcome: "Blood Glucose & HbA1c", level: "promising" as const, text: "Promising Evidence", summary: "Average −0.35 mmol/L fasting glucose and −0.45 percentage points HbA1c across 17 double-blind RCTs (Lei 2023)." },
  { outcome: "LDL Cholesterol & Triglycerides", level: "promising" as const, text: "Promising Evidence", summary: "Reductions of −0.41 mmol/L in LDL-C and −0.22 mmol/L in triglycerides; neutral effect on HDL-C." },
  { outcome: "Liver Enzymes in NAFLD", level: "preliminary" as const, text: "Preliminary Data", summary: "Significant transaminase drops (ALT/AST) across 10 trials; histological fibrosis reversal unverified (Nie 2024)." },
  { outcome: "Weight Loss / Adiposity", level: "limited" as const, text: "Limited Clinical Effect", summary: "Modest average weight reduction (−0.88 kg / ~1.9 lbs in Vahed 2026); this trial did not find a statistically significant reduction in visceral fat or liver fat compared with placebo over six months (Lei 2026)." },
  { outcome: "Transdermal Skin Patches", level: "none" as const, text: "Not Established", summary: "Commercial patches lack published human pharmacokinetic or clinical efficacy data." },
  { outcome: "Prescription Drug Interactions", level: "warning" as const, text: "Documented Safety Flag", summary: "Inhibits CYP3A4, CYP2D6, and P-glycoprotein; co-administration requires physician supervision." },
];
---

<Layout
  title="Berberine: Benefits, Weight Loss, Safety & Supplements"
  description="Evidence-based medical guide to berberine: clinical trials for blood sugar, cholesterol, weight loss reality (JAMA 2026), side effects, and top supplements."
>
