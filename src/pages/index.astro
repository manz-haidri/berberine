  <!-- 3. LATEST RESEARCH SUMMARIES (Digestible highlights) -->
  <section class="site-container py-10 border-t border-[#e6e6e6]" aria-label="Latest Research Summaries">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <span class="eyebrow text-[#213183]">Scientific Overview</span>
        <h2 class="heading-1 text-[#000000] tracking-tight m-0">
