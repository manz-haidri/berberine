    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Glycemic Impact -->
      <div class="feature-card bg-white space-y-3">
        <div class="flex items-center justify-between">
          <span class="eyebrow text-[#0075de]">Glycemic Control</span>
