      <!-- Weight & Liver Trial -->
      <div class="feature-card bg-white space-y-3">
        <div class="flex items-center justify-between">
          <span class="eyebrow text-[#dd5b00]">Adiposity & MASLD</span>
          <EvidenceBadge level="limited" text="Neutral on Visceral Fat" size="sm" />
        </div>
        <h3 class="text-lg font-bold text-[#000000] m-0">2026 Multicenter RCT</h3>
