            class="btn-secondary inline-flex items-center justify-center bg-white hover:bg-[#f6f5f4] active:bg-[#edebe9] text-[#213183] px-6 py-3.5 rounded-full font-semibold text-sm shadow-md transition-all w-full sm:w-auto min-h-[48px] focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#213183]"
