        <div class="flex items-center justify-between">
          <span class="eyebrow text-[#2a9d99]">Lipid Profile</span>
          <EvidenceBadge level="promising" text="Promising Evidence" size="sm" />
        </div>
        <h3 class="text-lg font-bold text-[#000000] m-0">Cholesterol & Lipids</h3>
