---
import Layout from '../layouts/Layout.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';

const inquiryCategories = [
  { value: "errata", label: "Scientific Study Correction / Errata (DOI / Trial Data)" },
  { value: "methodology", label: "Clinical Methodology & Research Inquiry" },
  { value: "supplement-audit", label: "Dietary Supplement Formulation Audit" },
  { value: "general", label: "General Feedback or Reader Question" },
  { value: "press", label: "Media, Press & Academic Citation Inquiry" },
  { value: "legal-privacy", label: "Privacy or Legal Compliance Notice" }
];

const directChannels = [
  {
    role: "Scientific & Errata Desk",
    email: "editorial@berberinebenefit.com",
    description: "Trial data corrections, forest plot reviews, PRISMA/Cochrane updates, and researcher queries.",
    icon: "🔬"
  },
  {
    role: "Supplement Audits Desk",
    email: "audits@berberinebenefit.com",
    description: "Certificate of Analysis (CoA) verification, manufacturer disclosures, and third-party lab tests.",
    icon: "💊"
  },
  {
    role: "Privacy & Data Protection",
    email: "privacy@berberinebenefit.com",
    description: "GDPR/CCPA data inquiries, deletion requests, and technical privacy questions.",
    icon: "🛡️"
  },
  {
    role: "General Support",
    email: "contact@berberinebenefit.com",
    description: "General reader inquiries, site navigation questions, and non-emergency feedback.",
    icon: "✉️"
  }
];
---

<Layout
  title="Contact Us & Editorial Inquiries | Berberine Portal"
  description="Contact the Berberine Research Portal editorial team. Submit corrections, clinical inquiries, study submissions, or press requests."
  canonical="https://berberinebenefit.com/contact/"
  isMedicalPage={false}
>
  <!-- Header Banner -->
  <div class="bg-white dark:bg-[#000000] border-b border-[#e6e6e6] dark:border-[#262626] py-8 sm:py-12">
    <div class="site-container">
      <nav class="text-xs text-[#615d59] dark:text-[#94a3b8] mb-3" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5 list-none p-0 m-0">
          <li><a href="/" class="hover:text-[#0075de] transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-[#000000] dark:text-[#f8fafc] font-medium" aria-current="page">Contact Us</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-[#0075de]/10 text-[#0075de] dark:bg-[#389bf2]/15 dark:text-[#389bf2] border border-[#0075de]/20">
          Editorial & Scientific Dialogue
        </span>
        <span class="text-xs text-[#615d59] dark:text-[#94a3b8]">
          Open to Researchers, Clinicians & Consumers
        </span>
      </div>

      <h1 class="display-2 text-[#000000] dark:text-[#f8fafc] tracking-tight m-0">
        Contact the Editorial & Research Team
      </h1>
      <p class="body-md text-[#615d59] dark:text-[#94a3b8] mt-3 max-w-3xl leading-relaxed">
        Have a clinical inquiry, study correction, scientific feedback, or partnership question? We welcome thoughtful dialogue from medical researchers, clinicians, formulation scientists, and readers.
      </p>
    </div>
  </div>

  <!-- Medical Disclaimer Strip -->
  <MedicalDisclaimer variant="banner" reviewedDate="October 2026 (Contact & Communication Protocol)" />

  <!-- Main Content Layout -->
  <div class="site-container py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Column: Interactive Contact Form (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="card-hoverable p-6 sm:p-8 rounded-xl bg-white dark:bg-[#0d0d0d] border border-[#e6e6e6] dark:border-[#262626] shadow-xs">
          
          <div class="mb-6 space-y-1">
            <h2 class="heading-2 text-[#000000] dark:text-[#f8fafc] m-0">
              Send an Editorial Inquiry
            </h2>
            <p class="text-xs sm:text-sm text-[#615d59] dark:text-[#94a3b8]">
              Fill out the form below. For scientific errata, please include the relevant DOI or PubMed ID.
            </p>
          </div>

          <!-- Honest Email Client Action Status Banner (Initially Hidden) -->
          <div id="contact-status" class="hidden p-5 mb-6 rounded-xl bg-[#f0f7ff] dark:bg-[#0c1a2e] border border-[#b8daff] dark:border-[#1e3a63] text-xs sm:text-sm text-[#005bab] dark:text-[#60aff5] space-y-2" role="status">
            <div class="font-bold flex items-center gap-2 text-sm sm:text-base text-[#000000] dark:text-[#f8fafc]">
              <span>✉️</span> Email Client Action Initiated
            </div>
            <p class="m-0 leading-relaxed text-[#31302e] dark:text-[#cbd5e1]">
              A pre-formatted email draft has been prepared for your default email client. Your message details are preserved below. If your email application did not launch automatically, you can send your inquiry directly to <a id="status-email-link" href="mailto:editorial@berberinebenefit.com" class="font-semibold underline text-[#0075de] dark:text-[#389bf2]">editorial@berberinebenefit.com</a>.
            </p>
          </div>

          <!-- Form Element -->
          <form id="contact-form" class="space-y-4" novalidate>
            <!-- Honeypot anti-spam (invisible to real users) -->
            <div class="hidden" aria-hidden="true">
              <label for="form-bot-check">Do not fill this field</label>
              <input type="text" id="form-bot-check" name="bot_field" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name Field -->
            <div>
              <label for="form-name" class="block text-xs font-bold uppercase tracking-wider text-[#31302e] dark:text-[#cbd5e1] mb-1.5">
                Your Full Name or Title <span class="text-[#dd5b00]">*</span>
              </label>
              <input
                type="text"
                id="form-name"
                name="name"
                required
                placeholder="e.g., Dr. Jane Doe or Alex Smith"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-white dark:bg-[#141414] text-[#000000] dark:text-[#f8fafc] border border-[#e6e6e6] dark:border-[#333333] focus:border-[#0075de] dark:focus:border-[#389bf2] focus:ring-1 focus:ring-[#0075de] dark:focus:ring-[#389bf2] transition-colors"
              />
              <span id="name-error" class="hidden text-[11px] text-[#dd5b00] mt-1 block">Please enter your name.</span>
            </div>

            <!-- Email Field -->
            <div>
              <label for="form-email" class="block text-xs font-bold uppercase tracking-wider text-[#31302e] dark:text-[#cbd5e1] mb-1.5">
                Email Address <span class="text-[#dd5b00]">*</span>
              </label>
              <input
                type="email"
                id="form-email"
                name="email"
                required
                placeholder="name@institution.org or name@domain.com"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-white dark:bg-[#141414] text-[#000000] dark:text-[#f8fafc] border border-[#e6e6e6] dark:border-[#333333] focus:border-[#0075de] dark:focus:border-[#389bf2] focus:ring-1 focus:ring-[#0075de] dark:focus:ring-[#389bf2] transition-colors"
              />
              <span id="email-error" class="hidden text-[11px] text-[#dd5b00] mt-1 block">Please enter a valid email address.</span>
            </div>

            <!-- Category Field -->
            <div>
              <label for="form-category" class="block text-xs font-bold uppercase tracking-wider text-[#31302e] dark:text-[#cbd5e1] mb-1.5">
                Inquiry Category <span class="text-[#dd5b00]">*</span>
              </label>
              <select
                id="form-category"
                name="category"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-white dark:bg-[#141414] text-[#000000] dark:text-[#f8fafc] border border-[#e6e6e6] dark:border-[#333333] focus:border-[#0075de] dark:focus:border-[#389bf2] focus:ring-1 focus:ring-[#0075de] dark:focus:ring-[#389bf2] transition-colors"
              >
                {inquiryCategories.map((cat) => (
                  <option value={cat.value}>{cat.label}</option>
                ))}
              </select>
            </div>

            <!-- Scientific Reference (Optional) -->
            <div>
              <label for="form-reference" class="block text-xs font-bold uppercase tracking-wider text-[#31302e] dark:text-[#cbd5e1] mb-1.5">
                Related DOI, PubMed ID, or Supplement URL <span class="text-xs text-[#615d59] dark:text-[#94a3b8] font-normal lowercase">(optional)</span>
              </label>
              <input
                type="text"
                id="form-reference"
                name="reference"
                placeholder="e.g., 10.1001/jamanetworkopen.2025.5678 or PMID: 39876543"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-white dark:bg-[#141414] text-[#000000] dark:text-[#f8fafc] border border-[#e6e6e6] dark:border-[#333333] focus:border-[#0075de] dark:focus:border-[#389bf2] focus:ring-1 focus:ring-[#0075de] dark:focus:ring-[#389bf2] transition-colors"
              />
            </div>

            <!-- Message Area -->
            <div>
              <label for="form-message" class="block text-xs font-bold uppercase tracking-wider text-[#31302e] dark:text-[#cbd5e1] mb-1.5">
                Message & Details <span class="text-[#dd5b00]">*</span>
              </label>
              <textarea
                id="form-message"
                name="message"
                rows="5"
                required
                placeholder="Describe your inquiry, trial data question, or feedback in detail..."
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-white dark:bg-[#141414] text-[#000000] dark:text-[#f8fafc] border border-[#e6e6e6] dark:border-[#333333] focus:border-[#0075de] dark:focus:border-[#389bf2] focus:ring-1 focus:ring-[#0075de] dark:focus:ring-[#389bf2] transition-colors resize-y"
              ></textarea>
              <span id="message-error" class="hidden text-[11px] text-[#dd5b00] mt-1 block">Please enter your message.</span>
            </div>

            <!-- Consent Checkbox -->
            <div class="pt-1">
              <label class="flex items-start gap-2.5 text-xs text-[#615d59] dark:text-[#94a3b8] cursor-pointer">
                <input
                  type="checkbox"
                  id="form-consent"
                  required
                  class="mt-0.5 rounded text-[#0075de] focus:ring-[#0075de] border-[#e6e6e6] dark:border-[#333333]"
                />
                <span>
                  I understand that this portal provides scientific research synthesis and does not deliver medical advice. I agree to the <a href="/privacy-policy/" class="text-[#0075de] dark:text-[#389bf2] underline">Privacy Policy</a>.
                </span>
              </label>
              <span id="consent-error" class="hidden text-[11px] text-[#dd5b00] mt-1 block">You must agree before submitting.</span>
            </div>

            <!-- Submit Button & Action Notice -->
            <div class="pt-3 space-y-2">
              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full sm:w-auto text-xs sm:text-sm py-2.5 px-6 font-semibold flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>✉️</span> <span id="submit-btn-text">Open email app</span>
              </button>
              <p class="text-[11px] text-[#615d59] dark:text-[#94a3b8] m-0 leading-relaxed">
                Notice: This static site does not store submissions on a server or use tracking forms. Clicking above formats your message and launches your configured email client.
              </p>
            </div>
          </form>

        </div>
      </div>

      <!-- Right Column: Direct Channels & Protocol (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Direct Inboxes Card -->
        <div class="card-hoverable p-6 rounded-xl bg-white dark:bg-[#0d0d0d] border border-[#e6e6e6] dark:border-[#262626] shadow-xs space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[#000000] dark:text-[#f8fafc] m-0">
            Dedicated Electronic Channels
          </h2>

          <div class="space-y-4">
            {directChannels.map((channel) => (
              <div class="p-3.5 rounded-lg bg-[#f6f5f4] dark:bg-[#141414] border border-[#e6e6e6] dark:border-[#262626] space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm">{channel.icon}</span>
                  <span class="text-xs font-bold text-[#000000] dark:text-[#f8fafc]">{channel.role}</span>
                </div>
                <div>
                  <a
                    href={`mailto:${channel.email}`}
                    class="font-mono text-xs font-semibold text-[#0075de] dark:text-[#389bf2] hover:underline"
                  >
                    {channel.email}
                  </a>
                </div>
                <p class="text-[11px] text-[#615d59] dark:text-[#94a3b8] m-0 leading-relaxed">
                  {channel.description}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Errata Protocol Card -->
        <div class="card-hoverable p-6 rounded-xl bg-[#f0f7ff] dark:bg-[#0c1a2e] border border-[#b8daff] dark:border-[#1e3a63] space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-base">📋</span>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#005bab] dark:text-[#60aff5] m-0">
              Scientific Errata Submission Protocol
            </h3>
          </div>
          <p class="text-xs text-[#213183] dark:text-[#cbd5e1] leading-relaxed m-0">
            We are committed to total empirical transparency. When challenging a study interpretation or requesting an erratum update:
          </p>
          <ul class="text-xs text-[#213183] dark:text-[#cbd5e1] list-disc pl-4 space-y-1 m-0">
            <li>Cite the exact page URL and paragraph;</li>
            <li>Provide the DOI or PubMed ID of the disputed trial;</li>
            <li>Submit conflicting peer-reviewed citations or meta-analytic data.</li>
          </ul>
          <p class="text-[11px] text-[#213183]/80 dark:text-[#94a3b8] m-0 pt-1">
            Valid errata reports are logged publicly on our <a href="/editorial-methodology/#corrections" class="underline font-semibold">Editorial Methodology</a> page.
          </p>
        </div>

        <!-- Quick Navigation Card -->
        <div class="card-hoverable p-6 rounded-xl bg-white dark:bg-[#0d0d0d] border border-[#e6e6e6] dark:border-[#262626] shadow-xs space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#000000] dark:text-[#f8fafc] m-0">
            Looking for Quick Answers?
          </h3>
          <ul class="space-y-2 list-none p-0 m-0 text-xs">
            <li>
              <a href="/faq/" class="text-[#0075de] dark:text-[#389bf2] hover:underline font-medium">
                → Frequently Asked Questions (FAQ)
              </a>
            </li>
            <li>
              <a href="/safety-and-side-effects/" class="text-[#0075de] dark:text-[#389bf2] hover:underline font-medium">
                → Side Effects & Medication Interactions Guide
              </a>
            </li>
            <li>
              <a href="/supplements/" class="text-[#0075de] dark:text-[#389bf2] hover:underline font-medium">
                → Compare 5 Verified Berberine Supplements
              </a>
            </li>
            <li>
              <a href="/weight-loss/" class="text-[#0075de] dark:text-[#389bf2] hover:underline font-medium">
                → Weight Loss & "Nature's Ozempic" Evidence Check
              </a>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </div>

  <!-- Client-side Form Validation and Submission Script -->
  <script is:inline>
    (function() {
      function setupContactForm() {
        var form = document.getElementById('contact-form');
        if (!form || form.dataset.listenerAttached) return;
        form.dataset.listenerAttached = 'true';

        form.addEventListener('submit', function(e) {
          e.preventDefault();

          var botCheck = document.getElementById('form-bot-check');
          if (botCheck && botCheck.value) {
            // Bot detected, silently exit
            return;
          }

          var nameInput = document.getElementById('form-name');
          var emailInput = document.getElementById('form-email');
          var messageInput = document.getElementById('form-message');
          var consentInput = document.getElementById('form-consent');

          var nameError = document.getElementById('name-error');
          var emailError = document.getElementById('email-error');
          var messageError = document.getElementById('message-error');
          var consentError = document.getElementById('consent-error');

          var hasError = false;

          // Name validation
          if (!nameInput.value.trim()) {
            nameError.classList.remove('hidden');
            hasError = true;
          } else {
            nameError.classList.add('hidden');
          }

          // Email validation
          var emailVal = emailInput.value.trim();
          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailVal || !emailRegex.test(emailVal)) {
            emailError.classList.remove('hidden');
            hasError = true;
          } else {
            emailError.classList.add('hidden');
          }

          // Message validation
          if (!messageInput.value.trim()) {
            messageError.classList.remove('hidden');
            hasError = true;
          } else {
            messageError.classList.add('hidden');
          }

          // Consent validation
          if (!consentInput.checked) {
            consentError.classList.remove('hidden');
            hasError = true;
          } else {
            consentError.classList.add('hidden');
          }

          if (hasError) return;

          // Channel routing map based on category
          var categorySelect = document.getElementById('form-category');
          var refInput = document.getElementById('form-reference');
          var categoryVal = categorySelect ? categorySelect.value : 'general';
          var categoryLabel = categorySelect && categorySelect.options[categorySelect.selectedIndex] ? categorySelect.options[categorySelect.selectedIndex].text : 'General Inquiry';

          var targetEmail = 'contact@berberinebenefit.com';
          if (categoryVal === 'errata' || categoryVal === 'methodology') {
            targetEmail = 'editorial@berberinebenefit.com';
          } else if (categoryVal === 'supplement-audit') {
            targetEmail = 'audits@berberinebenefit.com';
          } else if (categoryVal === 'legal-privacy') {
            targetEmail = 'privacy@berberinebenefit.com';
          }

          var subject = '[Editorial Inquiry - ' + categoryLabel.split('(')[0].trim() + '] from ' + nameInput.value.trim();
          var body = 'Sender: ' + nameInput.value.trim() + '\n' +
            'Email: ' + emailInput.value.trim() + '\n' +
            'Category: ' + categoryLabel + '\n' +
            'Reference (DOI / PMID / URL): ' + ((refInput && refInput.value.trim()) ? refInput.value.trim() : 'None provided') + '\n\n' +
            'Message Details:\n' + messageInput.value.trim() + '\n';

          var mailtoUrl = 'mailto:' + targetEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);

          // Prevent duplicate immediate clicks
          var submitBtn = document.getElementById('submit-btn');
          var submitBtnText = document.getElementById('submit-btn-text');
          if (submitBtn) submitBtn.disabled = true;
          if (submitBtnText) submitBtnText.textContent = 'Opening email app...';

          // Reveal status banner without wiping user message
          var statusBanner = document.getElementById('contact-status');
          var statusLink = document.getElementById('status-email-link');
          if (statusLink) {
            statusLink.href = 'mailto:' + targetEmail;
            statusLink.textContent = targetEmail;
          }
          if (statusBanner) {
            statusBanner.classList.remove('hidden');
            statusBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          // Trigger email client action
          try {
            window.location.href = mailtoUrl;
          } catch (err) {
            console.error('Mailto trigger error:', err);
          }

          setTimeout(function() {
            if (submitBtn) submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = 'Open email app';
          }, 2500);
        });
      }

      setupContactForm();
      document.addEventListener('astro:after-swap', setupContactForm);
    })();
  </script>
</Layout>
