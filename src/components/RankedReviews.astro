---
import { verifiedSupplementProducts, type SupplementProduct } from '../data/supplementProducts';

const products = verifiedSupplementProducts;
const topProduct = products[0];
const otherProducts = products.slice(1);
---

<div class="ranked-reviews space-y-10">
  <!-- Section Intro -->
  <div class="border-b border-[#e6e6e6] pb-4">
    <div class="inline-flex items-center gap-2 text-xs font-bold text-[#0075de] uppercase tracking-wider mb-1">
      <span>Results</span>
    </div>
    <h2 class="text-3xl lg:text-4xl font-normal text-[#000000] tracking-tight m-0 font-serif">
      Top 5 berberine supplements, <em class="italic text-[#0075de]">ranked.</em>
    </h2>
    <p class="text-sm text-[#615d59] mt-2 max-w-3xl leading-relaxed">
      Editorial review of five products based on manufacturer labels and publicly available documentation. This is an objective evaluation of documented packaging, testing scope, and price transparency—it is not a rating of clinical efficacy, medical treatment, or safety.
    </p>
  </div>

  <!-- #1 RANKED PRODUCT: WINNER UNDER EDITORIAL RUBRIC -->
  <article
    class="winner-card relative bg-white rounded-2xl border-2 border-[#0075de] shadow-elevated overflow-hidden"
    id={`review-${topProduct.id}`}
  >
    <!-- Top Rank Strip -->
    <div class="bg-gradient-to-r from-[#0075de] to-[#213183] text-white px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded bg-white/20">
          Rank 01 · Top Editorial Score
        </span>
        <span class="text-xs text-white/90 font-medium hidden sm:inline">
          Score: {topProduct.rubricScore} / 100 · Documented Facility cGMP Registration &amp; Analytical Testing
        </span>
      </div>
      <div class="text-xs font-semibold uppercase tracking-wider bg-white/10 px-2.5 py-0.5 rounded text-white">
        Rubric Score: {topProduct.rubricScore} / 100
      </div>
    </div>

    <div class="p-6 lg:p-8 space-y-6">
      <!-- Upper Grid: Image, Details & Score Dial -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Product Image -->
        <div class="md:col-span-4 lg:col-span-3 flex justify-center">
          <div class="w-44 h-56 p-2 bg-white rounded-xl border border-[#e6e6e6] flex items-center justify-center shadow-xs">
            <img
              src={topProduct.imageUrl}
              alt={topProduct.imageAlt}
              width="150"
              height="200"
              loading="eager"
              class="h-48 w-auto max-w-full object-contain"
            />
          </div>
        </div>

        <!-- Identity, Subtitle, Tags -->
        <div class="md:col-span-5 lg:col-span-6 space-y-3">
          <div class="text-xs font-bold text-[#0075de] uppercase tracking-wider">
            Rank 01 · Editorial Ranking (Tie-Breaker Winner)
          </div>
          <h3 class="text-2xl lg:text-3xl font-bold text-[#000000] tracking-tight m-0 font-serif">
            {topProduct.productName}
          </h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-[#615d59] m-0">
            {topProduct.declaredFormulationAmount} · {topProduct.servingsPerContainer} Servings
          </p>

          <!-- Badges & Verified Attributes -->
          <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px]">
            <span class="px-2 py-0.5 rounded bg-[#f0f9f3] text-[#1aae39] font-bold border border-[#1aae39]/30">
              Rubric Score: {topProduct.rubricScore}/100
            </span>
            <span class="px-2 py-0.5 rounded bg-[#f0f7ff] text-[#0075de] font-semibold border border-[#0075de]/30">
              {topProduct.formulationLabel}
            </span>
            <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6]">
              ${topProduct.pricePerServing.toFixed(2)} / serving
            </span>
            <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6]">
              {topProduct.capsulesPerBottle} Capsules
            </span>
            <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6]">
              NSF-Audited Facility
            </span>
          </div>
        </div>

        <!-- Score Dial / Visual Callout -->
        <div class="md:col-span-3 lg:col-span-3 flex md:flex-col items-center justify-center md:border-l md:border-[#e6e6e6] md:pl-6 py-2">
          <div class="w-24 h-24 rounded-full border-4 border-[#0075de] flex flex-col items-center justify-center bg-[#f0f7ff] text-center shadow-xs">
            <span class="font-serif text-3xl font-bold text-[#000000] leading-none">
              {topProduct.rubricScore}
            </span>
            <span class="text-[9px] uppercase tracking-wider text-[#0075de] font-bold mt-0.5">
              Score / 100
            </span>
          </div>
          <span class="text-[10px] text-[#615d59] mt-2 text-center block">
            Label: {topProduct.rubricBreakdown.labelClarity}/25 · Testing: {topProduct.rubricBreakdown.testingScope}/25
          </span>
        </div>
      </div>

      <!-- Accessible Expandable Domain Breakdown Section (Requirement 1) -->
      <details class="rubric-breakdown bg-[#faf9f8] border border-[#e6e6e6] rounded-xl p-4 text-xs transition-all">
        <summary class="cursor-pointer font-bold text-[#000000] flex items-center justify-between select-none">
          <span class="flex items-center gap-2">
            <span class="text-[#0075de]">▶</span>
            <span>View 4-Domain Scoring Breakdown &amp; Evidence ({topProduct.rubricScore}/100)</span>
          </span>
          <span class="text-[11px] text-[#615d59] font-normal">Click to expand</span>
        </summary>
        <div class="mt-4 pt-3 border-t border-[#e6e6e6] space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div class="p-3 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#000000]">1. Label Clarity &amp; Disclosure</span>
                <span class="font-bold text-[#0075de]">{topProduct.rubricBreakdown.labelClarity} / 25 pts</span>
              </div>
              <p class="text-[#615d59] leading-relaxed m-0 text-[11px]">
                {topProduct.rubricRationale.labelClarity}
              </p>
            </div>
            <div class="p-3 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#000000]">2. Testing &amp; Certification Scope</span>
                <span class="font-bold text-[#0075de]">{topProduct.rubricBreakdown.testingScope} / 25 pts</span>
              </div>
              <p class="text-[#615d59] leading-relaxed m-0 text-[11px]">
                {topProduct.rubricRationale.testingScope}
              </p>
            </div>
            <div class="p-3 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#000000]">3. Source Traceability</span>
                <span class="font-bold text-[#0075de]">{topProduct.rubricBreakdown.sourceTraceability} / 25 pts</span>
              </div>
              <p class="text-[#615d59] leading-relaxed m-0 text-[11px]">
                {topProduct.rubricRationale.sourceTraceability}
              </p>
            </div>
            <div class="p-3 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
              <div class="flex items-center justify-between">
                <span class="font-bold text-[#000000]">4. Price &amp; Serving Transparency</span>
                <span class="font-bold text-[#0075de]">{topProduct.rubricBreakdown.priceTransparency} / 25 pts</span>
              </div>
              <p class="text-[#615d59] leading-relaxed m-0 text-[11px]">
                {topProduct.rubricRationale.priceTransparency}
              </p>
            </div>
          </div>
          <div class="p-2.5 rounded bg-[#f0f7ff] border border-[#0075de]/20 text-[10.5px] text-[#005bab] leading-snug">
            <strong>Calculation &amp; Editorial Standard:</strong> Total score {topProduct.rubricScore}/100 is derived directly from the sum of the four domain scores ({topProduct.rubricBreakdown.labelClarity} + {topProduct.rubricBreakdown.testingScope} + {topProduct.rubricBreakdown.sourceTraceability} + {topProduct.rubricBreakdown.priceTransparency}). Ranks are determined ordinally based on calculated totals and published tie-breaking rules. These are editorial documentation scores, not clinical efficacy or safety ratings.
          </div>
        </div>
      </details>

      <!-- Strengths & Limitations Two-Column Section -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-[#e6e6e6]">
        <!-- Strengths -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#1aae39] flex items-center justify-between border-b border-[#e6e6e6] pb-1.5 m-0">
            <span>Strengths</span>
            <span class="text-[#615d59] font-normal text-[11px]">{topProduct.strengths.length.toString().padStart(2, '0')}</span>
          </h4>
          <ul class="list-none p-0 m-0 space-y-2 text-xs text-[#31302e]">
            {topProduct.strengths.map((str) => (
              <li class="flex items-start gap-2">
                <span class="text-[#1aae39] font-bold text-sm leading-none mt-0.5">+</span>
                <span class="leading-relaxed">{str}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Limitations -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#dd5b00] flex items-center justify-between border-b border-[#e6e6e6] pb-1.5 m-0">
            <span>Limitations</span>
            <span class="text-[#615d59] font-normal text-[11px]">{topProduct.limitations.length.toString().padStart(2, '0')}</span>
          </h4>
          <ul class="list-none p-0 m-0 space-y-2 text-xs text-[#31302e]">
            {topProduct.limitations.map((lim) => (
              <li class="flex items-start gap-2">
                <span class="text-[#dd5b00] font-bold text-sm leading-none mt-0.5">−</span>
                <span class="leading-relaxed">{lim}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Bottom Line Callout -->
      <div class="p-4 rounded-xl bg-[#f6f5f4] border border-[#e6e6e6] text-xs text-[#31302e] leading-relaxed">
        <strong class="font-bold text-[#0075de] uppercase tracking-wider block text-[11px] mb-1">
          Bottom Line
        </strong>
        {topProduct.bottomLine}
      </div>

      <!-- CTA & Action Footer -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 border-t border-[#e6e6e6]">
        <div class="flex items-center gap-2 text-xs text-[#615d59]">
          <span class="inline-block text-[#1aae39] font-bold">✓</span>
          <span>Verified Price: ${topProduct.priceUSD.toFixed(2)} USD · Checked {topProduct.priceCheckDate}</span>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto shrink-0">
          <button
            type="button"
            class="add-to-custom-compare-btn btn-secondary text-xs py-2.5 px-3.5 justify-center min-h-[42px] whitespace-normal sm:whitespace-nowrap text-center touch-manipulation"
            data-product-id={topProduct.id}
          >
            Compare in Side-by-Side Tool
          </button>
          <a
            href={topProduct.retailerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center gap-1.5 text-white text-xs font-bold py-2.5 px-5 rounded-full shadow-xs min-h-[42px] whitespace-nowrap text-center touch-manipulation"
          >
            <span>{topProduct.retailerCtaText}</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </article>

  <!-- Other Reviewed Products (Ranks 02 to 05) -->
  <div class="space-y-6">
    <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-[#615d59]">
      <span class="h-px bg-[#e6e6e6] flex-1"></span>
      <span>Also Reviewed · Ranks 02 to 05</span>
      <span class="h-px bg-[#e6e6e6] flex-1"></span>
    </div>

    {otherProducts.map((prod) => (
      <article
        class="comp-card bg-white rounded-xl border border-[#e6e6e6] hover:border-[#0075de]/50 transition-all p-5 sm:p-6 space-y-5 shadow-xs"
        id={`review-${prod.id}`}
      >
        <!-- Top Row: Image, Identity, Tags & Score -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
          <!-- Bottle Image -->
          <div class="md:col-span-3 lg:col-span-2 flex justify-center">
            <div class="w-24 h-32 p-1 bg-[#f6f5f4] rounded-lg border border-[#e6e6e6] flex items-center justify-center shrink-0">
              <img
                src={prod.imageUrl}
                alt={prod.imageAlt}
                width="80"
                height="110"
                loading="lazy"
                class="h-28 w-auto max-w-full object-contain"
              />
            </div>
          </div>

          <!-- Product Identity & Meta -->
          <div class="md:col-span-6 lg:col-span-7 space-y-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0075de]">
              {prod.rankBadge} · Editorial Review
            </span>
            <h3 class="text-xl font-bold text-[#000000] tracking-tight m-0 font-serif">
              {prod.productName}
            </h3>
            <p class="text-xs text-[#615d59] uppercase tracking-wider m-0">
              {prod.declaredFormulationAmount}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[10.5px]">
              <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6] font-semibold">
                Score: {prod.rubricScore}/100
              </span>
              <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6]">
                Serving: {prod.servingSize}
              </span>
              <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#31302e] border border-[#e6e6e6]">
                ${prod.pricePerServing.toFixed(2)}/serving {prod.priceStatus === 'Estimated' && '(Estimated)'}
              </span>
              <span class="px-2 py-0.5 rounded bg-[#f6f5f4] text-[#615d59] border border-[#e6e6e6]">
                {prod.qualityTesting.badgeText.length > 40 ? prod.qualityTesting.badgeText.slice(0, 38) + '...' : prod.qualityTesting.badgeText}
              </span>
            </div>
          </div>

          <!-- Score Circle on Right -->
          <div class="md:col-span-3 lg:col-span-3 flex md:flex-col items-center justify-center md:border-l md:border-[#e6e6e6] md:pl-4 py-2 md:py-0">
            <div class="w-18 h-18 rounded-full border-2 border-[#e6e6e6] flex flex-col items-center justify-center bg-[#f6f5f4] text-center p-2">
              <span class="font-serif text-2xl font-bold text-[#000000] leading-none">
                {prod.rubricScore}
              </span>
              <span class="text-[8.5px] uppercase tracking-wider text-[#615d59] font-bold mt-0.5">
                Score / 100
              </span>
            </div>
            <span class="text-[9.5px] text-[#a39e98] mt-1 text-center hidden md:block">
              {prod.rankBadge}
            </span>
          </div>
        </div>

        <!-- Accessible Expandable Domain Breakdown Section (Requirement 1) -->
        <details class="rubric-breakdown bg-[#faf9f8] border border-[#e6e6e6] rounded-xl p-3.5 text-xs transition-all">
          <summary class="cursor-pointer font-bold text-[#000000] flex items-center justify-between select-none">
            <span class="flex items-center gap-2">
              <span class="text-[#0075de]">▶</span>
              <span>View 4-Domain Scoring Breakdown &amp; Evidence ({prod.rubricScore}/100)</span>
            </span>
            <span class="text-[11px] text-[#615d59] font-normal">Click to expand</span>
          </summary>
          <div class="mt-3 pt-3 border-t border-[#e6e6e6] space-y-2.5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
              <div class="p-2.5 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-[#000000] text-[11px]">1. Label Clarity &amp; Disclosure</span>
                  <span class="font-bold text-[#0075de]">{prod.rubricBreakdown.labelClarity} / 25 pts</span>
                </div>
                <p class="text-[#615d59] leading-relaxed m-0 text-[10.5px]">
                  {prod.rubricRationale.labelClarity}
                </p>
              </div>
              <div class="p-2.5 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-[#000000] text-[11px]">2. Testing &amp; Certification Scope</span>
                  <span class="font-bold text-[#0075de]">{prod.rubricBreakdown.testingScope} / 25 pts</span>
                </div>
                <p class="text-[#615d59] leading-relaxed m-0 text-[10.5px]">
                  {prod.rubricRationale.testingScope}
                </p>
              </div>
              <div class="p-2.5 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-[#000000] text-[11px]">3. Source Traceability</span>
                  <span class="font-bold text-[#0075de]">{prod.rubricBreakdown.sourceTraceability} / 25 pts</span>
                </div>
                <p class="text-[#615d59] leading-relaxed m-0 text-[10.5px]">
                  {prod.rubricRationale.sourceTraceability}
                </p>
              </div>
              <div class="p-2.5 bg-white rounded-lg border border-[#e6e6e6] space-y-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-[#000000] text-[11px]">4. Price &amp; Serving Transparency</span>
                  <span class="font-bold text-[#0075de]">{prod.rubricBreakdown.priceTransparency} / 25 pts</span>
                </div>
                <p class="text-[#615d59] leading-relaxed m-0 text-[10.5px]">
                  {prod.rubricRationale.priceTransparency}
                </p>
              </div>
            </div>
            <div class="p-2 rounded bg-[#f0f7ff] border border-[#0075de]/20 text-[10px] text-[#005bab] leading-snug">
              <strong>Calculation &amp; Editorial Standard:</strong> Total score {prod.rubricScore}/100 is derived from the sum of the four domain scores ({prod.rubricBreakdown.labelClarity} + {prod.rubricBreakdown.testingScope} + {prod.rubricBreakdown.sourceTraceability} + {prod.rubricBreakdown.priceTransparency}). Editorial documentation score only; not a clinical efficacy rating.
            </div>
          </div>
        </details>

        <!-- Strengths & Limitations -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-[#e6e6e6] text-xs">
          <!-- Strengths -->
          <div class="space-y-1.5">
            <span class="font-bold text-[#1aae39] block uppercase text-[10.5px] tracking-wider border-b border-[#e6e6e6] pb-1">
              Strengths
            </span>
            <ul class="list-none p-0 m-0 space-y-1 text-[#31302e]">
              {prod.strengths.map((s) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-[#1aae39] font-bold text-sm leading-none mt-0.5">+</span>
                  <span class="leading-relaxed">{s}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Limitations -->
          <div class="space-y-1.5">
            <span class="font-bold text-[#dd5b00] block uppercase text-[10.5px] tracking-wider border-b border-[#e6e6e6] pb-1">
              Limitations
            </span>
            <ul class="list-none p-0 m-0 space-y-1 text-[#31302e]">
              {prod.limitations.map((l) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-[#dd5b00] font-bold text-sm leading-none mt-0.5">−</span>
                  <span class="leading-relaxed">{l}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Bottom Line Box -->
        <div class="p-3.5 rounded-lg bg-[#f6f5f4] border border-[#e6e6e6] text-xs text-[#31302e] leading-relaxed">
          <strong class="font-bold text-[#0075de] uppercase tracking-wider block text-[10.5px] mb-0.5">
            Bottom Line
          </strong>
          {prod.bottomLine}
        </div>

        <!-- Action Row -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-[#e6e6e6]">
          <div class="text-xs text-[#615d59] leading-relaxed">
            Serving: <strong>{prod.servingSize}</strong> · Price: <strong>${prod.priceUSD.toFixed(2)}</strong> ({prod.currency})
            {prod.priceStatus === 'Estimated' && (
              <span class="text-[11px] text-[#793400] font-normal ml-1 inline-block">(Estimated benchmark)</span>
            )}
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto shrink-0">
            <button
              type="button"
              class="add-to-custom-compare-btn btn-secondary text-xs py-2 px-3.5 justify-center min-h-[38px] whitespace-nowrap text-center touch-manipulation"
              data-product-id={prod.id}
            >
              Compare
            </button>
            <a
              href={prod.retailerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center justify-center gap-1 text-white text-xs font-semibold py-2 px-4 rounded-full min-h-[38px] whitespace-nowrap text-center touch-manipulation"
            >
              <span>{prod.retailerCtaText}</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  function setupRankedReviews() {
    // Connect "Compare" buttons to smooth scroll and visual feedback
    document.querySelectorAll('.add-to-custom-compare-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const origText = target.textContent?.trim() || '';
        if (!origText.includes('✓')) {
          target.textContent = origText.includes('Side-by-Side') ? 'Added to Comparison Tool ✓' : 'Added ✓';
          setTimeout(() => {
            target.textContent = origText;
          }, 1500);
        }

        const compareSection = document.getElementById('compare-supplements');
        if (compareSection) {
          compareSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Toggle detail marker rotation
    document.querySelectorAll('details.rubric-breakdown').forEach((detail) => {
      detail.addEventListener('toggle', (e) => {
        const el = e.currentTarget as HTMLDetailsElement;
        const arrow = el.querySelector('summary span span:first-child');
        if (arrow) {
          arrow.textContent = el.open ? '▼' : '▶';
        }
      });
    });
  }

  setupRankedReviews();
  document.addEventListener('astro:page-load', setupRankedReviews);
</script>
