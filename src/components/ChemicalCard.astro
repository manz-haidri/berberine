---
import { chemicalProperties, chineseNomenclature } from '../data/botanicalData';
---

<div class="feature-card-elevated my-6">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#e6e6e6] pb-3 mb-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-[#615d59]">Pharmacological Profile</span>
      <h3 class="text-xl font-bold text-[#000000] tracking-tight m-0">Chemical Identity & Properties</h3>
    </div>
    <div class="flex items-center gap-2">
      <span class="badge-pill bg-[#2a9d99]/10 text-[#2a9d99] border border-[#2a9d99]/30 text-xs">
        Isoquinoline Alkaloid
      </span>
      <span class="badge-pill bg-[#62aef0]/10 text-[#0075de] border border-[#62aef0]/30 text-xs">
        C20H18NO4+
      </span>
    </div>
  </div>

  <!-- Chinese Names Highlight -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6 bg-[#f6f5f4] p-3.5 rounded-xl border border-[#e6e6e6]">
    {chineseNomenclature.map((cn) => (
      <div class="bg-white p-3 rounded-lg border border-[#e6e6e6]">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-[#213183]">{cn.term}</span>
          <span class="text-xs font-mono text-[#615d59]">({cn.pinyin})</span>
        </div>
        <div class="text-xs font-semibold text-[#000000] mt-1">{cn.englishMeaning}</div>
        <p class="text-xs text-[#615d59] m-0 mt-1 leading-normal">{cn.context}</p>
      </div>
    ))}
  </div>

  <!-- Properties Table -->
  <div class="overflow-x-auto -mx-1 sm:mx-0" style="-webkit-overflow-scrolling: touch;">
    <table class="data-table text-xs min-w-[420px]">
      <thead>
        <tr>
          <th class="w-1/3 min-w-[120px]">Property</th>
          <th class="min-w-[280px]">Description & Pharmacological Reality</th>
        </tr>
      </thead>
      <tbody>
        {chemicalProperties.map((prop) => (
          <tr>
            <td class="font-semibold text-[#000000]">{prop.property}</td>
            <td class="text-[#31302e] leading-relaxed">{prop.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Critical Bioavailability Note -->
  <div class="mt-4 p-3.5 rounded-lg bg-[#fffaf5] border border-[#e6cbb2] text-xs text-[#523410]">
    <div class="font-semibold text-sm mb-1 text-[#793400]">Pharmacological Note: The Bioavailability Conundrum</div>
    <p class="m-0 leading-relaxed text-[#31302e]">
      One defining feature of berberine is its relatively low oral bioavailability (estimated below 5% systemic intact absorption). Berberine experiences significant P-glycoprotein (P-gp) mediated intestinal efflux and extensive first-pass hepatic metabolism. However, scientific consensus emphasizes that <em>low systemic bioavailability does not equal inactivity</em>: a substantial portion of berberine’s metabolic benefits is mediated via direct interactions in the gut lumen, the gut microbiome, intestinal endocrine cells (L-cells), and active circulating metabolites.
    </p>
  </div>
</div>
