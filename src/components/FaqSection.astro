---
import { berberineFaqs, generateFaqSchema, type FaqItem } from '../data/faqs';

export interface Props {
  title?: string;
  subtitle?: string;
  id?: string;
  items?: FaqItem[];
  includeSchema?: boolean;
}

const {
  title = "Frequently Asked Questions About Berberine",
  subtitle = "Direct, evidence-backed answers to the top queries on berberine benefits, weight loss reality, dosage, kidneys, timing, and safety.",
  id = "faq",
  items = berberineFaqs,
  includeSchema = true
} = Astro.props;

// Group FAQs by category
const categories = Array.from(new Set(items.map((f) => f.category)));

// Generate JSON-LD Schema
const faqJsonLd = generateFaqSchema(items);
---

<section id={id} class="site-container py-12 scroll-mt-20" aria-label="Frequently Asked Questions">
  <!-- JSON-LD FAQPage Schema for Search Engines & AI Overviews -->
  {includeSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}

  <!-- Section Header -->
  <div class="max-w-3xl mb-8">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#0075de]/10 text-[#0075de] text-xs font-semibold mb-3">
      <span>Clinical Evidence FAQ Hub</span>
      <span>•</span>
      <span>20 Verified Clinical Queries</span>
    </div>
    <h2 class="heading-1 text-[#000000] tracking-tight">
      {title}
    </h2>
    <p class="body-md text-[#615d59] mt-2">
      {subtitle}
    </p>
  </div>

  <!-- Interactive Search / Filter Bar -->
  <div class="mb-8">
    <div class="relative max-w-xl">
      <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-[#615d59]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>
      <input
        type="search"
        id="faq-search-input"
        placeholder="Filter questions (e.g. weight loss, kidneys, dosage, blood sugar)..."
        class="w-full pl-10 pr-4 py-3 rounded-xl border border-[#e6e6e6] bg-white text-base sm:text-sm text-[#000000] placeholder-[#a39e98] focus:outline-none focus:ring-2 focus:ring-[#0075de] transition-all touch-manipulation"
        aria-label="Filter FAQ questions"
      />
    </div>
  </div>

  <!-- FAQ Categorized Accordions -->
  <div class="space-y-10" id="faq-categories-container">
    {categories.map((cat) => {
      const categoryItems = items.filter((item) => item.category === cat);
      return (
        <div class="faq-category-block space-y-4">
          <div class="border-b border-[#e6e6e6] pb-2 flex items-center justify-between">
            <h3 class="text-sm sm:text-base font-bold text-[#000000] tracking-tight flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0075de]"></span>
              <span>{cat}</span>
            </h3>
            <span class="text-xs text-[#615d59] font-medium">{categoryItems.length} questions</span>
          </div>

          <div class="space-y-3">
            {categoryItems.map((faq) => (
              <details
                class="faq-item group bg-white rounded-xl border border-[#e6e6e6] p-4 sm:p-5 transition-all open:border-[#0075de]/30 open:shadow-xs"
                id={`faq-${faq.id}`}
                data-keywords={`${faq.question} ${faq.searchQuery} ${faq.answer} ${faq.category}`.toLowerCase()}
              >
                <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-[#000000] cursor-pointer list-none select-none py-2 min-h-[44px] touch-manipulation">
                  <span class="pr-3 leading-snug flex items-center gap-2">
                    <span class="text-[#0075de] text-xs font-bold" aria-hidden="true">Q:</span>
                    <span>{faq.question}</span>
                  </span>
                  <span class="ml-2 shrink-0 text-[#615d59] group-open:rotate-180 transition-transform duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>

                <div class="mt-4 pt-3 border-t border-[#f0ede9] text-xs sm:text-sm text-[#31302e] leading-relaxed space-y-3">
                  <p class="m-0 leading-relaxed font-normal">
                    {faq.answer}
                  </p>

                  {faq.linkUrl && faq.linkText && (
                    <div class="pt-1">
                      <a
                        href={faq.linkUrl}
                        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0075de] hover:underline min-h-[32px] group"
                      >
                        <span>{faq.linkText}</span>
                        <span class="card-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <!-- No Results Message -->
  <div id="faq-no-results" class="hidden text-center py-12 px-4 rounded-xl bg-white border border-[#e6e6e6] space-y-2 mt-4">
    <p class="text-sm font-semibold text-[#000000] m-0">No matching questions found</p>
    <p class="text-xs text-[#615d59] m-0">Try searching for keywords like "kidneys", "dosage", "weight loss", "blood sugar", or "patches".</p>
  </div>
</section>

<script>
  function setupFaqFilter() {
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    const categories = document.querySelectorAll<HTMLElement>('.faq-category-block');
    const noResults = document.getElementById('faq-no-results');

    if (!searchInput) return;

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let totalVisible = 0;

      items.forEach((item) => {
        const keywords = item.getAttribute('data-keywords') || '';
        const matches = !query || keywords.includes(query);
        item.style.display = matches ? '' : 'none';
        if (matches) {
          totalVisible++;
          if (query.length > 2) {
            item.setAttribute('open', '');
          }
        } else {
          item.removeAttribute('open');
        }
      });

      categories.forEach((cat) => {
        const visibleInCat = cat.querySelectorAll<HTMLDetailsElement>('.faq-item:not([style*="display: none"])');
        cat.style.display = visibleInCat.length > 0 ? '' : 'none';
      });

      if (noResults) {
        noResults.style.display = totalVisible === 0 ? 'block' : 'none';
      }
    });
  }

  setupFaqFilter();
  document.addEventListener('astro:page-load', setupFaqFilter);
</script>

