---
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-[#f6f5f4] dark:bg-[#000000] border-t border-[#e6e6e6] dark:border-[#262626] mt-20 pt-12 pb-16 text-xs text-[#615d59] dark:text-[#94a3b8]"
>
  <div class="site-container">
    <!-- Top Grid: 1 col on mobile, 2 cols on iPad portrait, 4 cols on desktop -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 pb-10 border-b border-[#e6e6e6] dark:border-[#262626]"
    >
      <!-- Brand & Mission -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5">
          <img
            src="/images/logo.svg"
            alt="Berberine Research Portal Logo"
            width="32"
            height="32"
            class="w-8 h-8 rounded-md object-contain shadow-2xs"
            loading="lazy"
          />
          <span class="font-bold text-lg text-[#000000] dark:text-[#f8fafc]"
            >Berberine</span
          >
        </div>
        <p class="text-xs text-[#31302e] dark:text-[#cbd5e1] leading-relaxed">
          The comprehensive, evidence-based research repository on Berberine (<span
            class="font-mono text-[#0075de] dark:text-[#389bf2]"
            >berberinebenefit.com</span
          >). Dedicated to translating peer-reviewed clinical trials into
          transparent, accessible science.
        </p>
        <div class="text-[11px] text-[#615d59] dark:text-[#94a3b8]">
          <span>Scientific Editorial Transparency</span><br />
          <strong class="text-[#31302e] dark:text-[#cbd5e1]"
            >Research & Product Audit: October 2026 • General Content: Fully
            Audited</strong
          >
        </div>
      </div>

      <!-- Research Pillars Links -->
      <div class="space-y-2">
        <div
          class="font-bold uppercase tracking-wider text-[#000000] dark:text-[#f8fafc] text-xs"
        >
          Research Pillars
        </div>
        <ul class="space-y-2 list-none p-0 m-0">
          <li>
            <a
              href="/what-is-berberine/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >What Is Berberine?</a>
          </li>
          <li>
            <a
              href="/what-is-berberine/#botanical-sources"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Plants Containing Berberine</a>
          </li>
          <li>
            <a
              href="/what-is-berberine/#berberine-hcl"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Berberine HCl Chemistry</a>
          </li>
          <li>
            <a
              href="/benefits/#blood-sugar"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Blood Glucose Regulation</a>
          </li>
          <li>
            <a
              href="/benefits/#cholesterol"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Lipid & Cholesterol Profile</a>
          </li>
          <li>
            <a
              href="/benefits/#liver"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >NAFLD Liver Transaminases</a>
          </li>
        </ul>
      </div>

      <!-- Supplements & Clinical Safety -->
      <div class="space-y-2">
        <div
          class="font-bold uppercase tracking-wider text-[#000000] dark:text-[#f8fafc] text-xs"
        >
          Clinical Safety & Forms
        </div>
        <ul class="space-y-2 list-none p-0 m-0">
          <li>
            <a
              href="/weight-loss/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Weight Loss & Ozempic Analysis</a>
          </li>
          <li>
            <a
              href="/supplements/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Supplement Forms & Buying Guide</a>
          </li>
          <li>
            <a
              href="/supplements/#phytosome-vs-hcl"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >HCl vs Phytosome Comparison</a>
          </li>
          <li>
            <a
              href="/supplements/#transdermal-patches"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Transdermal Patches Evidence</a>
          </li>
          <li>
            <a
              href="/safety-and-side-effects/#side-effects"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Gastrointestinal Side Effects</a>
          </li>
          <li>
            <a
              href="/safety-and-side-effects/#contraindications"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Contraindications & Pregnancy</a>
          </li>
        </ul>
      </div>

      <!-- Evidence & Transparency -->
      <div class="space-y-2">
        <div
          class="font-bold uppercase tracking-wider text-[#000000] dark:text-[#f8fafc] text-xs"
        >
          Evidence & Transparency
        </div>
        <ul class="space-y-2 list-none p-0 m-0">
          <li>
            <a
              href="/about/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >About Us & Editorial Board</a>
          </li>
          <li>
            <a
              href="/editorial-methodology/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Editorial Methodology & Standards</a>
          </li>
          <li>
            <a
              href="/research/#evidence-matrix"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Evidence Strength Matrix</a>
          </li>
          <li>
            <a
              href="/research/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Scientific Research Library</a>
          </li>
          <li>
            <a
              href="/faq/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Frequently Asked Questions (FAQ)</a>
          </li>
          <li>
            <a
              href="/contact/"
              class="text-[#31302e] dark:text-[#cbd5e1] hover:text-[#0075de] dark:hover:text-[#389bf2] inline-block py-0.5"
              >Contact Us & Errata Desk</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Editorial Standards & Medical Disclaimer -->
    <div class="pt-8 space-y-4">
      <!-- Scientific Research Portal & Audit Notice -->
      <div
        class="p-3.5 sm:p-4 rounded-xl bg-white dark:bg-[#0d0d0d] border border-[#e6e6e6] dark:border-[#262626] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-xs"
      >
        <div class="flex items-start sm:items-center gap-2.5">
          <span
            class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[#0075de] text-white font-bold text-[11px] shrink-0"
            aria-hidden="true">ℹ</span
          >
          <p class="m-0 leading-snug text-[#31302e] dark:text-[#cbd5e1]">
            <strong class="font-semibold text-[#000000] dark:text-[#f8fafc]"
              >Scientific Research Portal:</strong
            > Content is strictly for educational, informational, and research analysis.
            Not intended as medical advice or treatment.
          </p>
        </div>
        <div
          class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[#615d59] dark:text-[#94a3b8] text-[11px] shrink-0"
        >
          <span
            >Domain: <strong class="text-[#31302e] dark:text-[#cbd5e1]"
              >berberinebenefit.com</strong
            ></span
          >
          <span class="hidden sm:inline">•</span>
          <span
            >Evidence Audit: <strong class="text-[#31302e] dark:text-[#cbd5e1]"
              >October 2026</strong
            ></span
          >
        </div>
      </div>

      <div
        class="p-4 sm:p-5 rounded-xl bg-white dark:bg-[#0d0d0d] border border-[#e6e6e6] dark:border-[#262626] text-xs leading-relaxed space-y-2"
      >
        <div
          class="font-semibold text-[#000000] dark:text-[#f8fafc] uppercase tracking-wider text-[11px]"
        >
          Editorial & Methodological Standards
        </div>
        <p class="text-[#31302e] dark:text-[#cbd5e1] m-0">
          Content on <strong>berberinebenefit.com</strong> strictly differentiates
          between human randomized double-blind clinical trials (RCTs), biochemical
          cellular mechanisms (such as AMPK activation), animal models, and anecdotal
          user reports. Surrogate laboratory endpoints (such as fasting blood glucose
          or ALT levels) are clearly identified and not conflated with hard cardiovascular
          outcomes.
        </p>
        <p class="text-[#615d59] dark:text-[#94a3b8] m-0">
          <strong>Mandatory Medical Disclaimer:</strong> The information provided
          is strictly educational and does not constitute medical, diagnostic, or
          therapeutic advice. Berberine can interact with medications metabolized
          via cytochrome P450 pathways and glucose-lowering drugs. Always consult
          a qualified physician or healthcare provider before using dietary supplements.
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 text-[11px] text-[#615d59] dark:text-[#94a3b8]"
      >
        <div>
          © {currentYear}
          <strong>Berberine</strong> (<a
            href="https://berberinebenefit.com"
            class="text-[#0075de] dark:text-[#389bf2] hover:underline"
            >berberinebenefit.com</a
          >). All rights reserved.
        </div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
          <a
            href="/about/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >About Us</a
          >
          <span>•</span>
          <a
            href="/editorial-methodology/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >Editorial Methodology</a
          >
          <span>•</span>
          <a
            href="/privacy-policy/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >Privacy Policy</a
          >
          <span>•</span>
          <a
            href="/terms-and-conditions/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >Terms & Conditions</a
          >
          <span>•</span>
          <a
            href="/contact/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >Contact Us</a
          >
          <span>•</span>
          <a
            href="/safety-and-side-effects/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >Safety Warning</a
          >
          <span>•</span>
          <a
            href="/faq/"
            class="text-[#615d59] dark:text-[#94a3b8] hover:text-[#0075de] dark:hover:text-[#f8fafc] py-0.5"
            >FAQs</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
